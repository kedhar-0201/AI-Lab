def alpha_beta(depth, node, maximizing, values, alpha, beta):
    if depth == 3:
        return values[node]
    if maximizing:
        best = float('-inf')
        for i in range(2):
            value = alpha_beta(depth + 1, node * 2 + i,
                               False, values, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)
            if alpha >= beta:
                break
        return best
    else:
        best = float('inf')
        for i in range(2):
            value = alpha_beta(depth + 1, node * 2 + i,
                               True, values, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)
            if alpha >= beta:
                break
        return best
print("Enter 8 leaf node values:")
values = list(map(int, input().split()))
if len(values) != 8:
    print("Please enter exactly 8 values.")
else:
    result = alpha_beta(0, 0, True, values,
                       float('-inf'), float('inf'))
    print("Optimal value:", result)